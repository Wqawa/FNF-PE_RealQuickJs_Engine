diff --git a/src/ljdbg.h b/src/ljdbg.h
new file mode 100644
index 0000000..ea8c551
--- /dev/null
+++ b/src/ljdbg.h
@@ -0,0 +1,40 @@
+#ifndef LJDBG_H
+#define LJDBG_H
+/* 临时调试头：把 Lua 运行时内部状态写进设备上的 lj_dbg.log。 */
+#include <stdio.h>
+#include "lj_obj.h"
+
+static int ljdbg_strnew_calls = 0;
+
+static void ljdbg_dump(const char *tag, lua_State *L)
+{
+  FILE *f = fopen("/storage/emulated/0/RealQuickJS/lj_dbg.log", "a");
+  if (!f) return;
+  if (L) {
+    global_State *g = G(L);
+    fprintf(f, "%-14s L=%p g=%p dL=%ld tab=%p mask=%08x num=%u top=%p base=%p st=%u\n",
+      tag, (void *)L, (void *)g, (long)((char *)g - (char *)L),
+      (void *)g->str.tab, (unsigned)g->str.mask, (unsigned)g->str.num,
+      (void *)L->top, (void *)L->base, (unsigned)g->gc.state);
+  } else {
+    fprintf(f, "%-14s L=NULL\n", tag);
+  }
+  fclose(f);
+}
+
+static void ljdbg_strnew(const char *tag, lua_State *L, const char *str, size_t len)
+{
+  if (ljdbg_strnew_calls++ > 150) return;
+  FILE *f = fopen("/storage/emulated/0/RealQuickJS/lj_dbg.log", "a");
+  if (!f) return;
+  {
+    global_State *g = G(L);
+    fprintf(f, "%-14s L=%p g=%p dL=%ld tab=%p mask=%08x num=%u len=%u str=%.16s\n",
+      tag, (void *)L, (void *)g, (long)((char *)g - (char *)L),
+      (void *)g->str.tab, (unsigned)g->str.mask, (unsigned)g->str.num,
+      (unsigned)len, str ? str : "(null)");
+  }
+  fclose(f);
+}
+#define LJDBG(tag, L) ljdbg_dump(tag, L)
+#endif
